# @tpural/* live in GitHub Packages, not the public npm registry.
#
# NODE_AUTH_TOKEN is read from the environment so no credential is committed.
# In Actions this is the built-in GITHUB_TOKEN, provided each package has
# granted this repository read access (Package settings -> Manage Actions
# access). Locally, use a token with read:packages:
#
#   gh auth refresh -s read:packages
#   export NODE_AUTH_TOKEN=$(gh auth token)
@tpural:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
